<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>

		<!-- タスクトレイ機能(NotifyIcon)を利用するためにWinFormsを有効化 -->
		<!-- WPF標準機能だけではタスクトレイアイコンの実装が困難なため利用します -->
		<UseWindowsForms>true</UseWindowsForms>

		<!-- 高DPI環境での表示崩れを防止 -->
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- WPF が起動を管理するため、DPI は WinForms の起動 API ではなく manifest で指定する。 -->
        <NoWarn>$(NoWarn);WFAC010</NoWarn>

		<Platforms>AnyCPU;x64;ARM64</Platforms>
		<AssemblyName>Imel</AssemblyName>
		<RootNamespace>Imel</RootNamespace>

		<!-- アプリケーションのアイコン設定 -->
		<!-- エクスプローラーやタスクバーで表示されるexeファイルのアイコンです -->
		<ApplicationIcon>Imel.ico</ApplicationIcon>

		<!-- アプリケーションのバージョン情報 -->
		<!-- .NET Core/.NET 5以降ではAssemblyInfo.csではなくここで管理するのが標準です -->
		<Version>1.0.12</Version>
		<AssemblyVersion>1.0.12.0</AssemblyVersion>
		<FileVersion>1.0.12.0</FileVersion>

		<!-- アプリケーションメタデータ -->
		<Company>tabunugoku</Company>
		<Product>Imel</Product>
		<Copyright>Copyright © 2025 tabunugoku</Copyright>
	</PropertyGroup>

	<!-- Releaseビルドでは、exe/pdb にビルドしたPCのフォルダパスを埋め込まない（/_/ に置き換える） -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- アイコンをプログラム内からストリームとして読み込めるように埋め込みリソース化 -->
	<!-- GetManifestResourceStreamなどで実行時にアイコンデータを取得するために必要です -->
	<ItemGroup>
		<EmbeddedResource Include="Imel.ico" />
	</ItemGroup>

	<!-- Releaseビルドの時のみ README.md を出力ディレクトリにコピー -->
	<!-- 配布用パッケージ作成時の利便性向上のため -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- モダンなUIコンポーネントライブラリ -->
		<PackageReference Include="WPF-UI" Version="4.1.0" />
	</ItemGroup>
    <ItemGroup>
        <Compile Remove="Tests/**/*.cs" />
    </ItemGroup>

</Project>
